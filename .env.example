# Bắt buộc: chuỗi bí mật bất kỳ, dài, đừng dùng lại giá trị này
JWT_SECRET_KEY=

# Chatbot (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chỉ cần khi mở giao diện ở origin khác (vd Live Server). Cùng server thì bỏ trống.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Dữ liệu khuôn mặt
RESOURCE_DIR=resources
FACE_DATABASE_PATH=resources/face_database.pkl
KNOWN_FACES_DIR=resources/known_faces

# Cơ sở dữ liệu + sao lưu (mặc định: thư mục data/ cạnh dự án)
# DATA_DIR=data
# DB_PATH=data/school.db
# BACKUP_DIR=D:/backup-khkt
# BACKUP_KEEP=14

# Ảnh chụp tự động (đóng dấu ngày giờ), mặc định data/capture/<ngày>/
# CAPTURE_DIR=data/capture
# Font có tiếng Việt để đóng dấu (Windows tự dùng Arial nếu bỏ trống)
# CAPTURE_FONT=C:/Windows/Fonts/arial.ttf
# Ngày bắt đầu TUẦN 1 của năm học (thứ Hai) — để đánh số TUẦN trong file Excel
SCHOOL_WEEK1_START=2026-09-07

# 1 = tự tạo hồ sơ học sinh từ known_faces khi khởi động, 0 = tắt
AUTO_SYNC_STUDENTS=1
# Chênh lệch múi giờ so với UTC cho thống kê "hôm nay" (Việt Nam = 7)
TZ_OFFSET_HOURS=7

# Số lượt nhận diện chạy song song (CPU). Nhiều cờ đỏ quét cùng lúc sẽ xếp hàng.
INFER_WORKERS=2
# Cờ đỏ quét trùng cùng học sinh + cùng lỗi trong số phút này thì bỏ qua
DUPLICATE_WINDOW_MIN=5

# Mật khẩu mặc định cho create_admin.py (bỏ trống thì script sẽ hỏi)
ADMIN_PASSWORD=
